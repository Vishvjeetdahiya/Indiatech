# Required
DISCORD_TOKEN=your_discord_bot_token_here

# The exact name of the Discord role to assign on successful verification.
# This role must already exist in your server.
VERIFIED_ROLE_NAME=Verified Redditor

# Set to "true" to update the member's server nickname to their Reddit username.
# The bot needs the "Manage Nicknames" permission and must be ranked above
# the member's highest role in the server hierarchy.
UPDATE_NICKNAME=false
